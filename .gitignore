# Claude Code project-level directory (machine-local, not version-controlled)
.claude/

# Python bytecode cache (generated by py_compile during testing)
__pycache__/
*.pyc

# Crash dumps (Git Bash / Cygwin / MSYS2 stack dumps; Windows minidumps).
# A Git Bash crash drops bash.exe.stackdump in the repo root — recurring
# untracked noise that obscures genuinely-stranded files when triaging a
# dirty canonical checkout (seen during the #697 and #795 recoveries).
*.stackdump
*.dmp
